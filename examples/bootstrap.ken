# A fixed loop whose information has no origin: the checker should object.

time travel: fixed

agent Ada
agent Ada#2 is Ada#1 at e9
type Digit = 0 .. 9
fact code: Digit

action arrive(x: Agent)
  seen by: x
action enter_box(x: Agent)
  seen by: x

timeline:
  start:
    code = 7
  e1: arrive(Ada#2)
  e2: tell(Ada#2, Ada#1, code = 7)       # where did Ada#2 learn the code?
  e9: enter_box(Ada#1)                   # ...from herself, at e2
