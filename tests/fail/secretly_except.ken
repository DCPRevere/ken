# expect-ok
# Benedick thinks he's hidden; the speakers know he's there.
agent DonPedro, Leonato, Benedick
fact loves: bool = false
timeline:
  start:
    honest(DonPedro) = false
    seen by: DonPedro, Leonato
    seen by: Benedick hiding honest(DonPedro) hiding loves
  e1: tell(DonPedro, Leonato, loves)
        seen by: DonPedro, Leonato
        seen by: Benedick secretly except DonPedro and Leonato
expect at e1:
  Benedick believes loves
  DonPedro believes (Benedick believes loves)
  Leonato believes (Benedick believes loves)
  not (Benedick believes (DonPedro believes (Benedick believes loves)))
  DonPedro believes not (Benedick believes (DonPedro believes (Benedick believes loves)))
